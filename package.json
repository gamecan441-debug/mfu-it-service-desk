{
  "name": "mfu-it-service-desk",
  "version": "1.0.0",
  "description": "University IT Service Request & Issue Tracking Prototype",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/system.test.js",
    "init-db": "node db.js",
